# PostgreSQL database used by the catalog and RFQ submissions.
DATABASE_URL=

# Firebase Admin SDK settings for private RFQ attachment uploads.
# In Google-hosted environments with Application Default Credentials, omit
# FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY and configure the service
# identity with permission to write to the bucket.
FIREBASE_PROJECT_ID=solid-equipment-ltd
FIREBASE_STORAGE_BUCKET=solid-equipment-ltd.firebasestorage.app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend staff notifications. Verify the sender domain in Resend before launch.
RESEND_API_KEY=
RFQ_NOTIFICATION_EMAIL=
RFQ_FROM_EMAIL=
